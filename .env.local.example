NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Preview/development only. Production remains fail-closed even if enabled by mistake.
NEXT_PUBLIC_HEALTH_INPUT_ENABLED=false
NEXT_PUBLIC_HEALTH_INPUT_DIAGNOSTICS=false
# Vercel supplies NEXT_PUBLIC_VERCEL_ENV automatically. Local development may set:
# NEXT_PUBLIC_VERCEL_ENV=development

# Server-only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_HEALTH_PARSE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
